# ==============================================================================
# MAZHI SHETI (माझी शेती) — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or .env.local for development.
# NEVER commit production credentials or private keys to source control.

# ------------------------------------------------------------------------------
# 1. CLERK AUTHENTICATION & IDENTITY (Required)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/farmer
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/farmer
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/farmer/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding/farmer

# ------------------------------------------------------------------------------
# 2. NEON POSTGRESQL DATABASE CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# Neon PostgreSQL pooled connection string (used by Next.js server runtime)
DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Neon PostgreSQL direct connection string (used by Prisma CLI for migrations)
DIRECT_URL="postgresql://[user]:[password]@[endpoint].us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 3. CLOUD OBJECT STORAGE (Land Records, Soil Tests, Certificates)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=s3 # Options: s3, r2, local
STORAGE_BUCKET=mazhi-sheti-documents
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY_ID=your_aws_access_key
STORAGE_SECRET_ACCESS_KEY=your_aws_secret_key
STORAGE_ENDPOINT=https://s3.ap-south-1.amazonaws.com

# ------------------------------------------------------------------------------
# 4. AI AGRONOMIST & ADVISORY SERVICES (Gemini / Anthropic)
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini # Options: gemini, openai, anthropic
GEMINI_API_KEY=your_gemini_api_key_here
AI_SAFETY_GUARDRAIL_STRICT=true

# ------------------------------------------------------------------------------
# 5. IOT GATEWAY & TELEMETRY INGESTION (LoRaWAN & MQTT)
# ------------------------------------------------------------------------------
IOT_INGESTION_SECRET=your_iot_webhook_hmac_secret
MQTT_BROKER_URL=mqtts://broker.mazhisheti.io:8883
MQTT_CLIENT_ID=gateway-ingest-hub-01
MQTT_USERNAME=gateway_service_user
MQTT_PASSWORD=gateway_secure_password
DEVICE_HEARTBEAT_TIMEOUT_SECONDS=900
IRRIGATION_SAFETY_MAX_MINUTES=120

# ------------------------------------------------------------------------------
# 6. COMMUNICATION & NOTIFICATIONS (SMS, WhatsApp, Email)
# ------------------------------------------------------------------------------
SMS_PROVIDER=twilio # Options: twilio, msg91, kaleyra
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
WHATSAPP_API_TOKEN=your_meta_whatsapp_token
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_key
FROM_EMAIL=notifications@mazhisheti.in

# ------------------------------------------------------------------------------
# 7. PAYMENTS & ESCROW (Crop Marketplace & Equipment Rental)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_T8KoDPvXFqJ91x
RAZORPAY_KEY_ID=rzp_test_T8KoDPvXFqJ91x
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 8. MAPPING & SATELLITE (Field GIS & NDVI Vegetation Indices)
# ------------------------------------------------------------------------------
MAPBOX_ACCESS_TOKEN=pk.eyJ1Ij...
SENTINEL_HUB_CLIENT_ID=your_sentinel_client_id
SENTINEL_HUB_CLIENT_SECRET=your_sentinel_client_secret

# ------------------------------------------------------------------------------
# 9. NOVU IN-APP NOTIFICATIONS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_NOVU_APPLICATION_IDENTIFIER=hC214Re-oCCB

# ------------------------------------------------------------------------------
# 10. MONITORING, LOGGING & AUDIT (SENTRY & BETTER STACK)
# ------------------------------------------------------------------------------
# Better Stack (Centralized Application Logs & Uptime)
BETTER_STACK_SOURCE_TOKEN=your_better_stack_source_token_here
LOG_LEVEL=info # debug, info, warn, error

# Sentry (Error & Exception Monitoring)
SENTRY_DSN=https://your_sentry_dsn_here
NEXT_PUBLIC_SENTRY_DSN=https://your_public_sentry_dsn_here
SENTRY_ORG=your_sentry_organization_slug
SENTRY_PROJECT=mazhi-sheti
SENTRY_AUTH_TOKEN=sntrys_your_sentry_build_auth_token_here
NEXT_PUBLIC_APP_ENV=development # development, staging, production

# Authoritative Compliance Retention
AUDIT_LOG_RETENTION_DAYS=2555 # 7 years statutory compliance for financial records

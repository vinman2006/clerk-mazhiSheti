datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==============================================================================
// 1. IDENTITY & USER PROFILES (CLERK LINKED VIA clerkUserId)
// ==============================================================================

model User {
  id            String    @id @default(cuid())
  clerkUserId   String    @unique
  role          String    @default("FARMER") // FARMER, BANK_LOAN_OFFICER, BANK_ADMIN, PROVIDER_OWNER, AGRICULTURE_EXPERT, ADMIN, SUPER_ADMIN
  name          String?
  email         String?   @unique
  phone         String?   @unique
  status        String    @default("ACTIVE") // ACTIVE, PENDING_VERIFICATION, SUSPENDED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  farmerProfile       Farmer?
  organizationMembers OrganizationMember[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  payments            Payment[]

  @@index([clerkUserId])
  @@index([role])
}

model Farmer {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clerkUserId        String    @unique
  name               String
  phone              String
  email              String?
  avatarUrl          String?
  
  // Location
  state              String    @default("Maharashtra")
  district           String    @default("Pune")
  taluka             String    @default("Baramati")
  village            String    @default("Malegaon")
  pincode            String?
  latitude           Float?
  longitude          Float?

  // Farming Details
  totalLandAcres     Float     @default(0.0)
  ownershipType      String    @default("OWNED") // OWNED, LEASED, SHARECROPPER
  experienceYears    Int       @default(5)
  farmingMethod      String    @default("CONVENTIONAL") // CONVENTIONAL, TRANSITIONAL, ORGANIC, NO_TILL
  irrigationType     String    @default("DRIP") // DRIP, SPRINKLER, CANAL, BOREWELL, RAINFED

  // Sustainability Scores
  soilHealthScore    Float     @default(65.0)
  organicPercentage  Float     @default(15.0)
  transitionStage    Int       @default(2) // 1 to 6
  noTillPercentage   Float     @default(20.0)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  farms               Farm[]
  documents           FarmDocument[]
  organicPlans        OrganicPlan[]
  consents            Consent[]
  loanApplications    LoanApplication[]
  equipmentBookings   EquipmentBooking[]
  marketplaceListings MarketplaceListing[]

  @@index([clerkUserId])
  @@index([phone])
  @@index([district, taluka])
}

// ==============================================================================
// 2. INSTITUTIONAL ORGANIZATIONS (BANKS, FLEETS, COOPERATIVES)
// ==============================================================================

model BankOrganization {
  id                String            @id @default(cuid())
  name              String
  institutionType   String            @default("COOPERATIVE_BANK") // COOPERATIVE_BANK, PUBLIC_SECTOR_BANK, RRB, NBFC
  branchName        String
  registrationNo    String            @unique
  officialEmail     String
  phone             String
  status            String            @default("VERIFIED") // PENDING_VERIFICATION, VERIFIED, SUSPENDED
  createdAt         DateTime          @default(now())

  members           OrganizationMember[]
  loans             LoanApplication[]
  consents          Consent[]

  @@index([status])
  @@index([registrationNo])
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  organization   BankOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String           @default("BANK_LOAN_OFFICER") // BANK_ADMIN, BANK_LOAN_OFFICER, BANK_VERIFICATION_OFFICER, BANK_MANAGER
  status         String           @default("ACTIVE") // ACTIVE, SUSPENDED
  joinedAt       DateTime         @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

// ==============================================================================
// 3. FARM & FIELD SPATIAL HIERARCHY
// ==============================================================================

model Farm {
  id              String    @id @default(cuid())
  farmerId        String
  farmer          Farmer    @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  name            String
  totalAreaAcres  Float
  surveyNumber    String?
  location        String
  latitude        Float?
  longitude       Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  fields            Field[]
  documents         FarmDocument[]
  devices           Device[]
  irrigationSystems IrrigationSystem[]

  @@index([farmerId])
}

model Field {
  id                  String    @id @default(cuid())
  farmId              String
  farm                Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  name                String
  areaAcres           Float
  soilType            String    @default("Black Cotton Soil") // Black Cotton Soil, Red Loam, Alluvial, Sandy Loam
  currentCrop         String?   // Sugarcane, Soybean, Wheat, Cotton, Pomegranate, Onion
  cropVariety         String?
  sowingDate          DateTime?
  expectedHarvestDate DateTime?
  irrigationZone      String?
  isNoTill            Boolean   @default(false)
  status              String    @default("ACTIVE") // ACTIVE, FALLOW, HARVESTED
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  cropCycles          CropCycle[]
  soilRecords         SoilRecord[]
  soilTests           SoilTest[]
  devices             Device[]
  irrigationEvents    IrrigationEvent[]

  @@index([farmId])
}

// ==============================================================================
// 4. CROPS & CROPPING CYCLES
// ==============================================================================

model Crop {
  id                  String    @id @default(cuid())
  name                String    @unique // Sugarcane (ऊस), Soybean (सोयाबीन), etc.
  scientificName      String?
  season              String    @default("KHARIF") // KHARIF, RABI, ZAID, PERENNIAL
  defaultDurationDays Int       @default(120)
  waterRequirement    String    @default("MEDIUM") // LOW, MEDIUM, HIGH
  createdAt           DateTime  @default(now())

  cycles              CropCycle[]

  @@index([season])
}

model CropCycle {
  id                  String    @id @default(cuid())
  fieldId             String
  field               Field     @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  cropId              String
  crop                Crop      @relation(fields: [cropId], references: [id], onDelete: Restrict)
  variety             String?
  sowingDate          DateTime  @default(now())
  expectedHarvestDate DateTime?
  actualHarvestDate   DateTime?
  targetYieldKg       Float?
  actualYieldKg       Float?
  farmingMethod       String    @default("CONVENTIONAL") // CONVENTIONAL, TRANSITIONAL, ORGANIC, NO_TILL
  status              String    @default("SOWN") // SOWN, VEGETATIVE, FLOWERING, HARVEST_READY, HARVESTED, FAILED
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([fieldId, status])
  @@index([cropId])
}

// ==============================================================================
// 5. PRECISION SOIL HEALTH & LABORATORY ASSAYS
// ==============================================================================

model SoilRecord {
  id                     String    @id @default(cuid())
  fieldId                String
  field                  Field     @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  recordedAt             DateTime  @default(now())
  source                 String    @default("SENSOR") // SENSOR, LAB_IMPORT, MANUAL_ENTRY
  
  ph                     Float     @default(6.8)
  moisture               Float     @default(38.0) // Percentage
  temperature            Float     @default(24.5) // Celsius
  nitrogen               Float     @default(240.0) // kg/ha
  phosphorus             Float     @default(18.5) // kg/ha
  potassium              Float     @default(195.0) // kg/ha
  organicCarbon          Float     @default(0.72) // Percentage
  electricalConductivity Float     @default(0.45) // dS/m
  healthScore            Float     @default(74.0) // 0 - 100
  trend                  String    @default("IMPROVING") // IMPROVING, STABLE, DEGRADED
  recommendation         String?

  @@index([fieldId, recordedAt])
}

model SoilTest {
  id                     String    @id @default(cuid())
  fieldId                String
  field                  Field     @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  labName                String
  sampleId               String
  testDate               DateTime  @default(now())
  reportUrl              String?
  verifiedByLab          Boolean   @default(true)
  ph                     Float
  nitrogen               Float
  phosphorus             Float
  potassium              Float
  organicCarbon          Float
  micronutrients         String?
  createdAt              DateTime  @default(now())

  @@index([fieldId])
  @@index([sampleId])
}

// ==============================================================================
// 6. SMART IOT TELEMETRY & AUTOMATED IRRIGATION
// ==============================================================================

model Device {
  id                String    @id @default(cuid())
  farmId            String
  farm              Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  fieldId           String?
  field             Field?    @relation(fields: [fieldId], references: [id])
  deviceCode        String    @unique
  name              String
  deviceType        String    // SOIL_MOISTURE, WEATHER_STATION, SPRINKLER_CONTROLLER, WATER_LEVEL
  status            String    @default("ONLINE") // ONLINE, OFFLINE, MAINTENANCE
  batteryLevel      Float     @default(95.0)
  firmwareVersion   String    @default("v2.4.1")
  lastHeartbeat     DateTime  @default(now())
  createdAt         DateTime  @default(now())

  readings          DeviceReading[]
  irrigationSystems IrrigationSystem[]

  @@index([deviceCode])
  @@index([farmId])
  @@index([fieldId])
  @@index([status])
}

model DeviceReading {
  id          String    @id @default(cuid())
  deviceId    String
  device      Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  timestamp   DateTime  @default(now())
  moisture    Float?
  temperature Float?
  humidity    Float?
  ph          Float?
  battery     Float?
  rawPayload  String?

  @@index([deviceId, timestamp])
}

model IrrigationSystem {
  id                   String    @id @default(cuid())
  farmId               String
  farm                 Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  deviceId             String?
  device               Device?   @relation(fields: [deviceId], references: [id])
  name                 String
  type                 String    @default("SPRINKLER") // DRIP, SPRINKLER, PIVOT
  status               String    @default("IDLE") // IDLE, IRRIGATING, EMERGENCY_STOPPED, MAINTENANCE
  autoMode             Boolean   @default(true)
  moistureMinThreshold Float     @default(30.0) // Triggers ON if moisture drops below
  moistureMaxThreshold Float     @default(55.0) // Triggers OFF when target reached
  maxDurationMinutes   Int       @default(45) // Safety shutoff
  lastRunAt            DateTime?
  createdAt            DateTime  @default(now())

  events               IrrigationEvent[]

  @@index([farmId])
  @@index([deviceId])
}

model IrrigationEvent {
  id                 String            @id @default(cuid())
  systemId           String
  system             IrrigationSystem  @relation(fields: [systemId], references: [id], onDelete: Cascade)
  fieldId            String?
  field              Field?            @relation(fields: [fieldId], references: [id])
  trigger            String            @default("AUTO_SENSOR") // AUTO_SENSOR, MANUAL_OVERRIDE, SCHEDULE
  startTime          DateTime          @default(now())
  endTime            DateTime?
  durationSeconds    Int               @default(0)
  waterVolumeLiters  Float             @default(0.0)
  status             String            @default("COMPLETED") // IN_PROGRESS, COMPLETED, EMERGENCY_ABORTED
  notes              String?

  @@index([systemId, startTime])
}

// ==============================================================================
// 7. ORGANIC TRANSITION ROADMAP (6-STAGE BIOLOGICAL PROGRESSION)
// ==============================================================================

model OrganicPlan {
  id                String            @id @default(cuid())
  farmerId          String
  farmer            Farmer            @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  currentStage      Int               @default(2) // Stage 1 to 6
  startDate         DateTime          @default(now())
  targetOrganicDate DateTime?
  overallScore      Float             @default(45.0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  steps             TransitionStep[]

  @@index([farmerId])
}

model TransitionStep {
  id             String      @id @default(cuid())
  planId         String
  plan           OrganicPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  stageNumber    Int         // 1 to 6
  title          String
  description    String
  status         String      @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, VERIFIED
  targetDate     DateTime?
  completedDate  DateTime?
  evidenceNotes  String?

  @@index([planId, stageNumber])
}

// ==============================================================================
// 8. TRACTOR & AGRICULTURAL MACHINERY RENTAL
// ==============================================================================

model Equipment {
  id              String             @id @default(cuid())
  providerUserId  String
  name            String
  category        String             // TRACTOR, HARVESTER, ROTAVATOR, NO_TILL_PLANTER, SPRAYER
  makeModel       String
  horsepower      Int?
  hourlyRate      Float
  dailyRate       Float
  location        String
  status          String             @default("AVAILABLE") // AVAILABLE, RENTED, MAINTENANCE
  imageUrl        String?
  contactPhone    String
  createdAt       DateTime           @default(now())

  bookings        EquipmentBooking[]

  @@index([category, status])
  @@index([providerUserId])
}

model EquipmentBooking {
  id              String      @id @default(cuid())
  equipmentId     String
  equipment       Equipment   @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  farmerId        String
  farmer          Farmer      @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  startDate       DateTime
  endDate         DateTime
  totalHours      Int         @default(8)
  totalAmount     Float
  status          String      @default("PENDING") // PENDING, ACCEPTED, REJECTED, IN_PROGRESS, COMPLETED, CANCELLED
  deliveryAddress String
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  payments        Payment[]

  @@index([farmerId, status])
  @@index([equipmentId])
}

// ==============================================================================
// 9. CROP MARKETPLACE & DIRECT ORDERS
// ==============================================================================

model MarketplaceListing {
  id                String    @id @default(cuid())
  farmerId          String
  farmer            Farmer    @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  cropName          String
  variety           String?
  quantityKg        Float
  pricePerKg        Float
  minOrderKg        Float     @default(50.0)
  harvestDate       DateTime?
  organicCertified  Boolean   @default(false)
  location          String
  imageUrl          String?
  status            String    @default("ACTIVE") // ACTIVE, SOLD, EXPIRED
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  orders            MarketplaceOrder[]

  @@index([cropName, status])
  @@index([farmerId])
}

model MarketplaceOrder {
  id              String             @id @default(cuid())
  listingId       String
  listing         MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  buyerUserId     String
  buyerName       String
  buyerContact    String
  quantityKg      Float
  pricePerKg      Float
  totalAmount     Float
  deliveryAddress String
  status          String             @default("PENDING") // PENDING, CONFIRMED, IN_TRANSIT, DELIVERED, CANCELLED
  orderedAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  payments        Payment[]

  @@index([listingId])
  @@index([buyerUserId])
  @@index([status])
}

// ==============================================================================
// 10. BANK LOAN APPLICATIONS & FARM DOCUMENTS
// ==============================================================================

model LoanApplication {
  id                 String            @id @default(cuid())
  farmerId           String
  farmer             Farmer            @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  bankOrgId          String
  bank               BankOrganization  @relation(fields: [bankOrgId], references: [id], onDelete: Cascade)
  applicationNo      String            @unique
  schemeName         String            // Kisan Credit Card (KCC), Agri Infrastructure Fund, Organic Subsidy
  amountRequested    Float
  tenureMonths       Int               @default(36)
  purpose            String
  status             String            @default("SUBMITTED") // DRAFT, SUBMITTED, UNDER_REVIEW, DOCUMENTS_REQUIRED, VERIFIED, APPROVED, REJECTED, DISBURSED, CLOSED
  reviewedByUserId   String?
  reviewNotes        String?
  appliedDate        DateTime          @default(now())
  updatedDate        DateTime          @updatedAt

  @@index([farmerId, status])
  @@index([bankOrgId, status])
  @@index([applicationNo])
}

model FarmDocument {
  id                 String    @id @default(cuid())
  farmerId           String
  farmer             Farmer    @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  farmId             String?
  farm               Farm?     @relation(fields: [farmId], references: [id], onDelete: SetNull)
  title              String
  documentType       String    // LAND_7_12, SOIL_TEST_REPORT, WATER_RIGHTS, AADHAAR_IDENTITY, BANK_PASSBOOK, ORGANIC_CERTIFICATE
  fileUrl            String
  mimeType           String    @default("application/pdf")
  fileSizeBytes      Int?
  verificationStatus String    @default("PENDING") // PENDING, VERIFIED, REJECTED
  uploadedAt         DateTime  @default(now())

  @@index([farmerId])
  @@index([documentType])
}

// ==============================================================================
// 11. FARMER DATA CONSENT ARCHITECTURE
// ==============================================================================

model Consent {
  id             String            @id @default(cuid())
  farmerId       String
  farmer         Farmer            @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  bankOrgId      String
  bank           BankOrganization  @relation(fields: [bankOrgId], references: [id], onDelete: Cascade)
  purpose        String            @default("Credit Underwriting & Farm Verification")
  scopes         String            @default("farm_ownership,soil_health,crop_history") // Comma-separated list
  status         String            @default("ACTIVE") // ACTIVE, REVOKED, EXPIRED
  grantedAt      DateTime          @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?

  @@index([farmerId, bankOrgId, status])
}

// ==============================================================================
// 12. IMMUTABLE AUDIT LOGGING (SECURITY & COMPLIANCE)
// ==============================================================================

model AuditLog {
  id                  String    @id @default(cuid())
  actorId             String
  actorUserId         String?
  actorOrganizationId String?
  actorRole           String
  actorName           String?
  action              String    // FARM_CREATED, CONSENT_GRANTED, BANK_VIEWED_SOIL_DATA, etc.
  resource            String    // FARM, SOIL, LOAN, IRRIGATION, USER
  resourceType        String?
  resourceId          String?
  purpose             String?
  details             String?
  ipAddress           String?
  userAgent           String?
  metadata            String?   // JSON string of sanitized metadata
  timestamp           DateTime  @default(now())

  userId              String?
  user                User?     @relation(fields: [userId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([timestamp])
  @@index([resource, resourceId])
}

// ==============================================================================
// 13. NOTIFICATIONS SYSTEM
// ==============================================================================

model Notification {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  message      String
  category     String    @default("SYSTEM") // SOIL, IRRIGATION, LOAN, EQUIPMENT, SYSTEM
  read         Boolean   @default(false)
  link         String?
  createdAt    DateTime  @default(now())

  @@index([userId, read])
}

// ==============================================================================
// 14. PRODUCTION RAZORPAY PAYMENT SYSTEM & WEBHOOK IDEMPOTENCY
// ==============================================================================

model Payment {
  id                 String            @id @default(cuid())
  orderId            String            // Business order ID (EquipmentBooking or MarketplaceOrder)
  orderType          String            @default("EQUIPMENT_BOOKING") // EQUIPMENT_BOOKING, MARKETPLACE_ORDER, SERVICE_ORDER
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  razorpayOrderId    String            @unique
  razorpayPaymentId  String?           @unique
  razorpaySignature  String?
  
  amount             Float             // Authoritative INR amount (e.g. 6800.0)
  amountPaise        Int               // Smallest currency unit integer (e.g. 680000)
  currency           String            @default("INR")
  status             String            @default("CREATED") // CREATED, AUTHORIZED, CAPTURED, FAILED, CANCELLED, REFUNDED, PARTIALLY_REFUNDED
  method             String?           // UPI, CARD, NETBANKING, WALLET
  
  signatureVerified  Boolean           @default(false)
  failureReason      String?
  
  refundStatus       String            @default("NONE") // NONE, PENDING, REFUNDED, PARTIALLY_REFUNDED
  refundAmount       Float?            @default(0.0)
  
  // Optional direct relations to business orders
  equipmentBookingId String?
  equipmentBooking   EquipmentBooking? @relation(fields: [equipmentBookingId], references: [id], onDelete: SetNull)
  marketplaceOrderId String?
  marketplaceOrder   MarketplaceOrder? @relation(fields: [marketplaceOrderId], references: [id], onDelete: SetNull)
  
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  paidAt             DateTime?

  @@index([orderId, orderType])
  @@index([userId])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@index([status])
}

model RazorpayWebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  eventType   String
  status      String   @default("PROCESSED") // PROCESSED, FAILED, SKIPPED
  payload     String?  // Sanitized summary/metadata
  processedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([eventId])
  @@index([eventType])
}

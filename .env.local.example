# ==============================================================================
# MAZHI SHETI (माझी शेती) — LOCAL ENVIRONMENT CONFIGURATION
# ==============================================================================

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/farmer
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/farmer
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/farmer/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding/farmer

# Neon PostgreSQL
DATABASE_URL="postgresql://user:password@endpoint-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@endpoint.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Razorpay Payments
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Novu Notifications
NEXT_PUBLIC_NOVU_APPLICATION_IDENTIFIER=your_novu_app_id
